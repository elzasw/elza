package ISADG;

import cz.tacr.elza.drools.model.ItemType;

rule "Item types of ISAD(G)"
when $it: ItemType(code in ("ISADG_LEVEL", "ISADG_REFERENCE_CODE", "ISADG_OTHER_ID", "ISADG_TITLE", "ISADG_DATE", "ISADG_DATE_BULK", "ISADG_DATE_TEXT", "ISADG_EXTENT", "ISADG_EXTENT_QUANTITY", "ISADG_MATERIAL_TYPE", "ISADG_DIMENSIONS", "ISADG_SCALE", "ISADG_DURATION", "ISADG_CREATOR", "ISADG_BIOGHIST", "ISADG_CUSTODHIST", "ISADG_ACQINFO", "ISADG_SCOPE_CONTENT", "ISADG_APPRAISAL", "ISADG_ACCRUALS", "ISADG_ARRANGEMENT", "ISADG_ACCESS_CONDITIONS", "ISADG_ACCESS_STATUS", "ISADG_ACCESS_OPEN_DATE", "ISADG_REPRODUCTION_CONDITIONS", "ISADG_LANGUAGE", "ISADG_SCRIPT", "ISADG_PHYSTECH", "ISADG_FINDING_AIDS", "ISADG_ORIGINALS_LOC", "ISADG_COPIES_LOC", "ISADG_RELATED_MATERIAL", "ISADG_RELATED_LINK", "ISADG_BIBLIOGRAPHY", "ISADG_NOTE", "ISADG_INTERNAL_NOTE", "ISADG_PROCESS_INFO", "ISADG_ARCHIVIST", "ISADG_RULES", "ISADG_DESCRIPTION_DATE", "ISADG_CONTAINER", "ISADG_CONTAINER_KIND", "ISADG_CONTAINER_PREFIX", "ISADG_CONTAINER_NUMBER", "ISADG_CONTAINER_POSTFIX", "ISADG_CONTAINER_LOCATION", "ISADG_DAO_LINK", "ISADG_ACCESS_POINT", "ISADG_FA_TITLE", "ISADG_FA_KIND", "ISADG_FA_AUTHOR", "ISADG_FA_DATE", "ISADG_FA_LANGUAGE", "ISADG_FA_NOTE", "ISADG_ATTACHMENT"))
then
    $it.setPossible();
end
