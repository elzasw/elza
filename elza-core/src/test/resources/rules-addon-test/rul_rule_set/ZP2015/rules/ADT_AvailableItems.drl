package AddonTest;

import cz.tacr.elza.domain.RulItemSpec;
import cz.tacr.elza.domain.RulItemType;
import cz.tacr.elza.domain.RulItemTypeExt;
import cz.tacr.elza.domain.RulItemSpecExt;
import cz.tacr.elza.drools.model.ActiveLevel;
import cz.tacr.elza.drools.model.Level;
import cz.tacr.elza.drools.model.DescItem;

// Addon rules for the ZP2015 rule set. The rule set runs each ATTRIBUTE_TYPES file in its own
// session ordered by priority, so with priority 200 these rules see the state left by the ZP2015
// rules (priority 100) and may extend or override it.

rule "ADT_001 Addon stage is possible on folders"
no-loop
when
    $activeLevel : ActiveLevel( )
    DescItem(type=="ZP2015_LEVEL_TYPE" && specCode=="ZP2015_LEVEL_FOLDER") from $activeLevel.descItems
    $itemType : RulItemTypeExt(code == "ADT_STAGE")
then
    $itemType.setType(RulItemType.Type.POSSIBLE);
    $itemType.setRepeatable(false);
    $itemType.setPolicyTypeCode("ZP2015_POL_BASIC");
end

rule "ADT_002 Addon identifier specification is possible on folders"
no-loop
when
    $activeLevel : ActiveLevel( )
    DescItem(type=="ZP2015_LEVEL_TYPE" && specCode=="ZP2015_LEVEL_FOLDER") from $activeLevel.descItems
    $itemType : RulItemTypeExt(code == "ZP2015_OTHER_ID")
    $itemSpec : RulItemSpecExt(code == "ADT_OTHERID_TEST") from $itemType.rulItemSpecList
then
    $itemSpec.setType(RulItemSpec.Type.POSSIBLE);
    $itemSpec.setPolicyTypeCode("ZP2015_POL_BASIC");
end

// Overrides ZP2015 rule PP_001, which makes the internal note possible on every level.
rule "ADT_003 Internal note is not used on folders"
no-loop
when
    $activeLevel : ActiveLevel( )
    DescItem(type=="ZP2015_LEVEL_TYPE" && specCode=="ZP2015_LEVEL_FOLDER") from $activeLevel.descItems
    $itemType : RulItemTypeExt(code == "ZP2015_INTERNAL_NOTE")
then
    $itemType.setType(RulItemType.Type.IMPOSSIBLE);
end
