	xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
	xmlns:inheritance="urn:jaxb.jvnet.org:plugin:inheritance"
    xmlns:namespace="http://jaxb2-commons.dev.java.net/basic/namespace-prefix"
    jaxb:extensionBindingPrefixes="xjc">

	<jaxb:bindings schemaLocation="ead3.xsd">
        <jaxb:bindings node="//xs:attributeGroup[@name='am.common']/xs:attribute[@name='script']">
