    <changeSet id="20240304112900" author="sergey.iryupin">
    	<createTable tableName="hsearch_agent">
    		<column name="assigned_shard_index" type="int" />
    		<column name="total_shard_count" type="int" />
            <column name="expiration" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="varchar(255)" />
            <column name="type" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="bytea" />
    	</createTable>
    	<createTable tableName="hsearch_outbox_event">
    		<column name="entity_id_hash" type="int" />
    		<column name="retries" type="int" />
            <column name="process_after" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="varchar(256)" />
            <column name="entity_name" type="varchar(256)" />
            <column name="status" type="varchar(256)" />
            <column name="tenant_id" type="varchar(255)" />
            <column name="payload" type="bytea" />
    	</createTable>
    </changeSet>

    <changeSet id="20240415153400" author="fantis">
        <createTable tableName="storage_external_system">
            <column name="external_system_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_storage_external_system" nullable="false"/>
            </column>
            <column name="type" type="nvarchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="external_system_id" baseTableName="storage_external_system"
                                 constraintName="fk_storage_external_system" referencedColumnNames="external_system_id"
                                 referencedTableName="sys_external_system"/>
    </changeSet>

    <changeSet id="20240415164800" author="fantis">
        <createTable tableName="digital_archive_external_system">
            <column name="external_system_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_digital_archive_external_system" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="external_system_id" baseTableName="digital_archive_external_system"
                                 constraintName="fk_digital_archive_external_system" referencedColumnNames="external_system_id"
                                 referencedTableName="sys_external_system"/>
    </changeSet>

    <changeSet id="20240416105600" author="fantis">
        <createTable tableName="arr_aip">
            <column name="aip_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_arr_aip" nullable="false"/>
            </column>
            <column name="ext_aip_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="aip_version" type="int"/>
            <column name="aip_size" type="int"/>
            <column name="fund_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="institution_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="create_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="dip_type" type="nvarchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="process_state" type="nvarchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="sync_date" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="20240418105600" author="fantis">
        <addColumn tableName="arr_aip">
            <column name="name" type="nvarchar(250)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20240425135500" author="fantis">
        <dropAllForeignKeyConstraints baseTableName="storage_external_system"/>
        <dropTable tableName="storage_external_system"/>

        <addColumn tableName="arr_digital_repository">
            <column name="digital_repository_type" type="nvarchar(50)"/>
        </addColumn>

        <sql>UPDATE arr_digital_repository adr SET digital_repository_type = 'WSDL' WHERE adr.view_dao_url is not null</sql>
        <sql>UPDATE arr_digital_repository adr SET digital_repository_type = 'FILESYSTEM' WHERE adr.view_file_url is not null</sql>

        <addNotNullConstraint tableName="arr_digital_repository" columnName="digital_repository_type"/>
    </changeSet>

    <changeSet id="20240425150400" author="fantis">
        <dropAllForeignKeyConstraints baseTableName="digital_archive_external_system"/>
        <dropTable tableName="digital_archive_external_system"/>

        <createTable tableName="da_remote_repository">
            <column name="external_system_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_da_remote_repository" nullable="false"/>
            </column>
            <column name="digital_repository_id" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="external_system_id" baseTableName="da_remote_repository"
                                 constraintName="fk_da_remote_repository" referencedColumnNames="external_system_id"
                                 referencedTableName="sys_external_system"/>
        <addForeignKeyConstraint baseColumnNames="digital_repository_id" baseTableName="da_remote_repository"
                                 constraintName="fk_da_remote_repository_digital_repository" referencedColumnNames="external_system_id"
                                 referencedTableName="arr_digital_repository"/>
    </changeSet>

    <changeSet id="20240425173100" author="fantis">
        <createTable tableName="da_remote_repository_sync">
            <column name="remote_repository_sync_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_da_remote_repository_sync" nullable="false"/>
            </column>
            <column name="remote_repository_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="last_update" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="remote_repository_id" baseTableName="da_remote_repository_sync"
                                 constraintName="fk_da_remote_repository_sync_da_remote_repository" referencedColumnNames="external_system_id"
                                 referencedTableName="da_remote_repository"/>
    </changeSet>

    <changeSet id="20240425174700" author="fantis">
        <createTable tableName="da_remote_aip">
            <column name="remote_aip_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_da_remote_aip" nullable="false"/>
            </column>
            <column name="code" type="nvarchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="aip_version" type="nvarchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="fund_code" type="nvarchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="institution_code" type="nvarchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="remote_repository_id" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="remote_repository_id" baseTableName="da_remote_aip"
                                 constraintName="fk_da_remote_aip_da_remote_repository" referencedColumnNames="external_system_id"
                                 referencedTableName="da_remote_repository"/>

        <createTable tableName="da_sync_queue_item">
            <column name="sync_queue_item_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_da_sync_queue_item" nullable="false"/>
            </column>
            <column name="code" type="nvarchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="aip_version" type="nvarchar(250)"/>
            <column name="state" type="nvarchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="remote_repository_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="remote_aip_id" type="int"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="remote_repository_id" baseTableName="da_sync_queue_item"
                                 constraintName="fk_da_sync_queue_item_da_remote_repository" referencedColumnNames="external_system_id"
                                 referencedTableName="da_remote_repository"/>
        <addForeignKeyConstraint baseColumnNames="remote_aip_id" baseTableName="da_sync_queue_item"
                                 constraintName="fk_da_sync_queue_item_da_remote_aip" referencedColumnNames="remote_aip_id"
                                 referencedTableName="da_remote_aip"/>
    </changeSet>

    <changeSet id="20240425180200" author="fantis">
        <dropAllForeignKeyConstraints baseTableName="arr_aip"/>
        <dropTable tableName="arr_aip"/>

        <createTable tableName="da_aip">
            <column name="aip_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_da_aip" nullable="false"/>
            </column>
            <column name="code" type="nvarchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="aip_version" type="nvarchar(250)"/>
            <column name="aip_size" type="bigint"/>
            <column name="digital_repository_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="aip_type" type="nvarchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="remote_aip_id" type="int"/>
            <column name="fund_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="create_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="last_change" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="unitdate_from" type="timestamp"/>
            <column name="unitdate_to" type="timestamp"/>
            <column name="originator_code" type="nvarchar(250)"/>
            <column name="originator_id" type="int"/>
            <column name="ingestion_code" type="nvarchar(250)"/>
            <column name="ref_no" type="nvarchar(250)"/>
            <column name="change_code" type="nvarchar(250)"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="digital_repository_id" baseTableName="da_aip"
                                 constraintName="fk_da_aip_arr_digital_repository" referencedColumnNames="external_system_id"
                                 referencedTableName="arr_digital_repository"/>
        <addForeignKeyConstraint baseColumnNames="remote_aip_id" baseTableName="da_aip"
                                 constraintName="fk_da_aip_da_remote_aip" referencedColumnNames="remote_aip_id"
                                 referencedTableName="da_remote_aip"/>
        <addForeignKeyConstraint baseColumnNames="fund_id" baseTableName="da_aip"
                                 constraintName="fk_da_aip_arr_fund" referencedColumnNames="fund_id"
                                 referencedTableName="arr_fund"/>
        <addForeignKeyConstraint baseColumnNames="originator_id" baseTableName="da_aip"
                                 constraintName="fk_da_aip_ap_access_point" referencedColumnNames="access_point_id"
                                 referencedTableName="ap_access_point"/>
        <addUniqueConstraint columnNames="code, digital_repository_id" tableName="da_aip"
                             constraintName="UNIQ_da_aip"/>
    </changeSet>


</databaseChangeLog>
