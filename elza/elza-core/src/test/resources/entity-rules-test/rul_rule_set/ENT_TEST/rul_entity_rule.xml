<entity-rules>
    <!-- same file name as in CAM: the files of rule sets are kept apart -->
    <entity-rule filename="available_items/PT_NAME.drl" kind="AVAILABLE_ITEMS" part-type="PT_NAME" priority="100"/>
    <entity-rule filename="index/PT_NAME.groovy" kind="INDEX" part-type="PT_NAME" priority="100"/>
    <!-- validation of the package's own part type PT_ENT_NOTE -->
    <entity-rule filename="validation/GLOBAL.drl" kind="VALIDATION" priority="100"/>
    <!-- computed items: for all classes, and a more specific script for the local persons -->
    <entity-rule filename="auto_items/GLOBAL.groovy" kind="AUTO_ITEMS" priority="100"/>
    <entity-rule filename="auto_items/ENT_PERSON_LOCAL.groovy" kind="AUTO_ITEMS" ap-type="ENT_PERSON_LOCAL" priority="100"/>
</entity-rules>
