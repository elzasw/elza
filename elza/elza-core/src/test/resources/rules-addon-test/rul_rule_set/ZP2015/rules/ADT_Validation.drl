package AddonTest;

import cz.tacr.elza.drools.model.Level;
import cz.tacr.elza.drools.model.ActiveLevel;
import cz.tacr.elza.drools.model.DescItem;
import cz.tacr.elza.domain.vo.DataValidationResult;
import cz.tacr.elza.domain.vo.DataValidationResults;

global DataValidationResults dvResults;

rule "ADT_001 A folder must carry the addon stage"
when
    $activeLevel : ActiveLevel( $items: descItems )
    DescItem(type=="ZP2015_LEVEL_TYPE" && specCode=="ZP2015_LEVEL_FOLDER") from $items
    not DescItem(type=="ADT_STAGE") from $items
then
    dvResults.createMissing("ADT_STAGE", "Addon stage is missing (rule ADT_001).", "ZP2015_POL_BASIC");
end
