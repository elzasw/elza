		    <column name="status" type="varchar(256)" />
		</createIndex>
		<createIndex indexName="hsearch_outbox_event_process_after_idx" tableName="hsearch_outbox_event">
		    <column name="process_after" type="timestamptz" />
		</createIndex>
		<createIndex indexName="hsearch_outbox_event_entity_id_hash_idx" tableName="hsearch_outbox_event">
		    <column name="entity_id_hash" type="int" />
		</createIndex>
		<!-- ext_syncs_queue_item -->
		<createIndex indexName="ext_syncs_queue_item_state_idx" tableName="ext_syncs_queue_item">
		    <column name="state" type="nvarchar(50)" />
		</createIndex>
	</changeSet>
	<changeSet id="20241218173400" author="ppy">
	    <sql dbms="postgresql">DELETE FROM arr_cached_node WHERE node_id IN (
	    select n.node_id from arr_node n
        left join arr_level l on l.node_id = n.node_id and l.delete_change_id is null
        where l.level_id is null
	    )</sql>
	</changeSet>
	<changeSet id="20250109112300" author="ppy">
		<!-- Speedup structured items, index was conditionally removed -->
		<sql dbms="postgresql">CREATE INDEX arr_item_data_idx ON arr_item(data_id)</sql>
	</changeSet>

