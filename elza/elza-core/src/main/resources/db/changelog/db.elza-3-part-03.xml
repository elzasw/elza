<?xml version="1.0" encoding="UTF-8"?>
<!-- OPEN - the only file that accepts new changesets. Every new changeset,
     regardless of subsystem (arrangement, DA, fs-repo, AI, ...), is appended
     here in chronological order; execution order equals file order in
     db.changelog-master.yaml, so a changeset may depend on anything in the
     files above it and on earlier changesets of this file, never on later
     ones.

     When a release line is cut from main: mark this file FROZEN (header
     comment with the release and date), never touch it again, and open
     db.elza-3-part-04.xml as the new last include in
     db.changelog-master.yaml. The part number is a sequence marker, not an
     ELZA version - release traceability belongs in the freeze header. -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="20260812110000" author="ppy">
        <!-- Filesystem repositories persist no entities (da-migration.md steps
             3a+3b): the ArrDao anchor rows and their per-fund packages became
             unreferenced orphans after the 3b link conversion, yet still
             surfaced in the package and unassigned-entity tabs. Remove them,
             together with their request references - requests were never
             meaningful for filesystem repositories (the notification gate
             always excluded them), so rows recorded against fs daos are
             historical junk. The guard asserts the 3b conversion left no live
             legacy link on a filesystem dao; a non-empty fs package would fail
             on the arr_dao FK, loudly. -->
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM arr_legacy_dao_link ll
                  JOIN arr_dao d ON d.dao_id = ll.dao_id
                  JOIN arr_dao_package p ON p.dao_package_id = d.dao_package_id
                  JOIN arr_digital_repository r ON r.external_system_id = p.digital_repository_id
                 WHERE r.digital_repository_type = 'FILESYSTEM'
            </sqlCheck>
        </preConditions>
        <sql dbms="postgresql">
            DELETE FROM arr_request_queue_item
             WHERE request_id IN (SELECT dlr.request_id FROM arr_dao_link_request dlr
                                   WHERE dlr.dao_id IN (SELECT d.dao_id FROM arr_dao d
                                       JOIN arr_dao_package p ON p.dao_package_id = d.dao_package_id
                                       JOIN arr_digital_repository r ON r.external_system_id = p.digital_repository_id
                                      WHERE r.digital_repository_type = 'FILESYSTEM'));
            DELETE FROM arr_dao_link_request
             WHERE dao_id IN (SELECT d.dao_id FROM arr_dao d
                                JOIN arr_dao_package p ON p.dao_package_id = d.dao_package_id
                                JOIN arr_digital_repository r ON r.external_system_id = p.digital_repository_id
                               WHERE r.digital_repository_type = 'FILESYSTEM');
            DELETE FROM arr_request br
             WHERE br.discriminator = 'DAO_LINK'
               AND NOT EXISTS (SELECT 1 FROM arr_dao_link_request dlr WHERE dlr.request_id = br.request_id);
            DELETE FROM arr_dao_request_dao
             WHERE dao_id IN (SELECT d.dao_id FROM arr_dao d
                                JOIN arr_dao_package p ON p.dao_package_id = d.dao_package_id
                                JOIN arr_digital_repository r ON r.external_system_id = p.digital_repository_id
                               WHERE r.digital_repository_type = 'FILESYSTEM');
            DELETE FROM arr_dao_file
             WHERE dao_id IN (SELECT d.dao_id FROM arr_dao d
                                JOIN arr_dao_package p ON p.dao_package_id = d.dao_package_id
                                JOIN arr_digital_repository r ON r.external_system_id = p.digital_repository_id
                               WHERE r.digital_repository_type = 'FILESYSTEM');
            DELETE FROM arr_dao
             WHERE dao_package_id IN (SELECT p.dao_package_id FROM arr_dao_package p
                                        JOIN arr_digital_repository r ON r.external_system_id = p.digital_repository_id
                                       WHERE r.digital_repository_type = 'FILESYSTEM');
            DELETE FROM arr_dao_package
             WHERE digital_repository_id IN (SELECT external_system_id FROM arr_digital_repository
                                              WHERE digital_repository_type = 'FILESYSTEM');
        </sql>
    </changeSet>

    <changeSet id="20260812120000" author="ppy">
        <!-- Settings addressing an external repository system do not apply to a filesystem
             repository: getDaoUrl returns null for it, file and thumbnail URLs are replaced
             by the built-in item-data endpoint, notifications are never sent and credentials
             are read only by the DA/WSDL connector. The administration no longer offers these
             fields for a filesystem repository, so clear the values existing records still
             carry - an invisible value must not keep influencing behaviour. -->
        <sql dbms="postgresql">
            UPDATE arr_digital_repository
               SET view_dao_url = NULL,
                   view_file_url = NULL,
                   view_thumbnail_url = NULL,
                   send_notification = false
             WHERE digital_repository_type = 'FILESYSTEM';

            UPDATE sys_external_system
               SET username = NULL,
                   password = NULL
             WHERE external_system_id IN (SELECT external_system_id FROM arr_digital_repository
                                           WHERE digital_repository_type = 'FILESYSTEM');
        </sql>
    </changeSet>

    <changeSet id="20260828100000" author="ppy">
        <!-- Download settings of a DA repository. download_method selects how AIP
             batches are fetched (STANDARD = HTTP GET per the DA OpenAPI, FILE_TRANSFER
             = File Transfer protocol); on_received selects the automatic action when
             the DA reports a newly received AIP (NONE, DOWNLOAD_METADATA). Both apply
             to DA repositories only, other types keep the defaults. -->
        <addColumn tableName="arr_digital_repository">
            <column name="download_method" type="varchar(50)" defaultValue="STANDARD">
                <constraints nullable="false"/>
            </column>
            <column name="on_received" type="varchar(50)" defaultValue="NONE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260828140000" author="ppy">
        <!-- Interval of the synchronization with a DA repository, in seconds; 0 = the
             repository is not synchronized. Replaces the elza.da.sync configuration, so the
             value is administered per repository instead of per deployment. Existing
             repositories start at the default of 5 minutes; a deployment that used a
             different interval sets it again in the administration. -->
        <addColumn tableName="arr_digital_repository">
            <column name="sync_delay" type="int" defaultValueNumeric="300">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260828160000" author="ppy">
        <!-- Problem state of an AIP: what prevents it from being processed or from being
             mapped onto the archival description (metadata processing failure, unresolved
             fund, unresolved institution). Replaces the metadata_error flag as the value the
             user filters and reads; the flag itself stays as the raw processing outcome the
             state is derived from. Existing failures are carried over. -->
        <addColumn tableName="da_aip_state">
            <column name="problem_type" type="nvarchar(50)"/>
            <column name="problem_description" type="${type.text}"/>
        </addColumn>
        <sql dbms="postgresql">
            UPDATE da_aip_state
               SET problem_type = 'METADATA_ERROR',
                   problem_description = CASE
                       WHEN metadata_error_exception IS NULL THEN NULL
                       ELSE 'Chyba při zpracování metadat: ' || metadata_error_exception
                   END
             WHERE delete_change_id IS NULL AND metadata_error IS TRUE;

            UPDATE da_aip_state
               SET problem_type = 'UNKNOWN_FUND',
                   problem_description = 'Fond nebyl nalezen podle čísla fondu ani podle interního kódu.'
             WHERE delete_change_id IS NULL AND metadata_error IS NOT TRUE AND fund_id IS NULL;

            UPDATE da_aip_state
               SET problem_type = 'UNKNOWN_INSTITUTION',
                   problem_description = 'Instituce nebyla nalezena.'
             WHERE delete_change_id IS NULL AND metadata_error IS NOT TRUE
               AND fund_id IS NOT NULL AND institution_id IS NULL;
        </sql>
    </changeSet>

    <changeSet id="20260829090000" author="ppy">
        <!-- One description of the problem of an AIP, whatever kind of problem it is. The type
             in problem_type is what tells the kinds apart, so the columns describing a problem
             are the same for all of them: problem_description is what the user reads,
             problem_detail the chain of causes for the diagnostics and problem_file the file
             of the package the problem is about. This replaces the columns that could only
             describe a failure of the metadata processing - the flag is the type, and the
             exception message was both the description and the detail. Existing failures keep
             their detail and are described again by the next processing of the AIP. -->
        <addColumn tableName="da_aip_state">
            <column name="problem_detail" type="${type.text}"/>
            <column name="problem_file" type="${type.text}"/>
        </addColumn>
        <sql>
            UPDATE da_aip_state
               SET problem_detail = metadata_error_exception
             WHERE metadata_error IS TRUE AND metadata_error_exception IS NOT NULL;
        </sql>
        <dropColumn tableName="da_aip_state" columnName="metadata_error"/>
        <dropColumn tableName="da_aip_state" columnName="metadata_error_exception"/>
    </changeSet>

    <changeSet id="20260830090000" author="ppy">
        <!-- Columns holding a value of an enumeration are declared as nvarchar in the rest of
             the schema; download_method and on_received were declared as varchar. -->
        <modifyDataType tableName="arr_digital_repository" columnName="download_method" newDataType="nvarchar(50)"/>
        <modifyDataType tableName="arr_digital_repository" columnName="on_received" newDataType="nvarchar(50)"/>
    </changeSet>

    <changeSet id="20260830100000" author="ppy">
        <!-- Outcome of a queue item: when its state last changed and, for the error states,
             why. Without them a failed item is a dead end - the reason only ever reached the
             log, so the user saw "Chyba stažení" with no way to learn what went wrong. Mirrors
             ext_syncs_queue_item, which describes its states the same way. -->
        <addColumn tableName="da_sync_queue_item">
            <column name="date" type="timestamp with time zone"/>
            <column name="state_message" type="${type.text}"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260829100000" author="ppy">
        <!-- Actions requested over AIPs, so that an action has an outcome the user can be shown.
             Recorded per AIP, because that is the granularity at which an action succeeds or
             fails - one AIP of a selection can be rebuilt while the next one has nothing to
             rebuild from. The progress of an action is derived from its items and is deliberately
             not stored: items are finished independently and, once the actions run in parallel,
             on different threads, where counters would have to be updated concurrently. -->
        <createTable tableName="da_aip_action">
            <column name="aip_action_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_da_aip_action" nullable="false"/>
            </column>
            <column name="action_type" type="nvarchar(50)">
                <constraints nullable="false"/>
            </column>
            <!-- null for an action nobody asked for, started by the synchronization -->
            <column name="user_id" type="int">
                <constraints foreignKeyName="fk_da_aip_action_usr_user"
                             referencedTableName="usr_user"
                             referencedColumnNames="user_id"/>
            </column>
            <column name="create_date" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="finish_date" type="timestamp with time zone"/>
        </createTable>

        <createTable tableName="da_aip_action_item">
            <column name="aip_action_item_id" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_da_aip_action_item" nullable="false"/>
            </column>
            <column name="aip_action_id" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_da_aip_action_item_action"
                             referencedTableName="da_aip_action"
                             referencedColumnNames="aip_action_id"/>
            </column>
            <column name="aip_id" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_da_aip_action_item_da_aip"
                             referencedTableName="da_aip"
                             referencedColumnNames="aip_id"/>
            </column>
            <column name="state" type="nvarchar(50)">
                <constraints nullable="false"/>
            </column>
            <!-- what happened to this AIP, in the words the user reads -->
            <column name="message" type="${type.text}"/>
            <column name="finish_date" type="timestamp with time zone"/>
        </createTable>
        <createIndex tableName="da_aip_action_item" indexName="ix_da_aip_action_item_action">
            <column name="aip_action_id"/>
        </createIndex>

        <!-- The queue item carries the action item it is carrying out, so an action finished by
             the digital archive is reported the same way as one ELZA finishes on its own. -->
        <addColumn tableName="da_sync_queue_item">
            <column name="aip_action_item_id" type="int">
                <constraints foreignKeyName="fk_da_sync_queue_item_action_item"
                             referencedTableName="da_aip_action_item"
                             referencedColumnNames="aip_action_item_id"/>
            </column>
        </addColumn>

        <insert tableName="db_hibernate_sequences">
            <column name="sequence_name" value="da_aip_action|aip_action_id"/>
            <column name="next_val" value="0"/>
        </insert>
        <insert tableName="db_hibernate_sequences">
            <column name="sequence_name" value="da_aip_action_item|aip_action_item_id"/>
            <column name="next_val" value="0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
