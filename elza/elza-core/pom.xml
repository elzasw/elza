                                <source>${project.build.directory}/generated-sources/cam-v2</source>
                                <source>${project.build.directory}/generated-sources/mets</source>
                                <source>${project.build.directory}/generated-sources/premis3</source>
                                <!-- <source>${project.build.directory}/generated-sources/api/rest</source> -->
                            </sources>
                        </configuration>
