                            </bindingIncludes>
                            <catalog>src/main/resources/xsd/mets/catalog.cat</catalog>
                            <plugins>
                                <plugin>
                                    <groupId>org.jvnet.jaxb</groupId>
                                    <artifactId>jaxb-plugins</artifactId>
                                    <version>${jaxb.version}</version>
                                </plugin>
                            </plugins>
                        </configuration>
