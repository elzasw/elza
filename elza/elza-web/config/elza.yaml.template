  # Task scheduler observability (the elza.scheduler.* and elza.cam.pending_* metrics).
  # The values below are the built-in defaults, already applied in code — with no
  # configuration the scheduler behaves exactly as shown, so leave this commented out for
  # normal operation and uncomment only to override. A pool size > 1 keeps one stuck
  # scheduled task from freezing the others; the watchdog logs the stack trace of a task
  # that runs longer than stuckThresholdSeconds.
  #monitoring:
  #  scheduler:
  #    poolSize: 4                  # scheduler threads (default 4)
  #    heartbeatMs: 30000           # liveness heartbeat interval in ms (default 30000)
  #    stuckThresholdSeconds: 1800  # watchdog stack-trace threshold in s (default 1800)

spring:
  app:
    buildType: DEV
  jpa:
    properties:
      hibernate:
        # PostgreSQL
        dialect: org.hibernate.spatial.dialect.postgis.PostgisDialect
        # H2
        #dialect: org.hibernate.spatial.dialect.h2geodb.GeoDBDialect
        # MySQL
        #dialect: org.hibernate.spatial.dialect.mysql.MySQLSpatialDialect
        # Oracle
        #dialect: org.hibernate.spatial.dialect.oracle.OracleSpatial10gDialect
        # MSSQL
        #dialect: org.hibernate.dialect.SQLServer2008Dialect

