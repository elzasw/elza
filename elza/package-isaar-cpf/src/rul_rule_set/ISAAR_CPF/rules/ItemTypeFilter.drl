package isaarcpf.itemtypes;

import cz.tacr.elza.drools.model.ItemType;

rule "ISAAR(CPF) item types"
when $it: ItemType(code in ("NM_MAIN", "NM_MINOR", "NM_TYPE", "NM_LANG", "NM_USED_FROM", "NM_USED_TO", "IDN_TYPE", "IDN_VALUE", "IDN_VALID_FROM", "IDN_VALID_TO", "REL_ENTITY", "REL_BEGIN", "REL_END", "CRE_DATE", "CRE_CLASS", "EXT_DATE", "EXT_CLASS", "EV_TYPE", "EV_BEGIN", "EV_END", "BRIEF_DESC", "HISTORY", "GENEALOGY", "CORP_STRUCTURE", "FOUNDING_NORMS", "SCOPE_NORMS", "SOURCE_INFO", "SOURCE_LINK", "NOTE", "COORD_POINT", "GEO_ADMIN_CLASS", "ISAAR_CORP_TYPE", "ISAAR_LEGAL_STATUS", "ISAAR_FAMILY_TYPE", "ISAAR_PLACE_TYPE", "ISAAR_CONCEPT_SCHEME", "ISAAR_FUNCTIONS", "ISAAR_PLACES", "ISAAR_GENERAL_CONTEXT"))
then
    $it.setPossible();
end
