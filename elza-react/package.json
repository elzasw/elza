{
  "name": "elza-react-ui",
  "private": true,
  "version": "0.2.0",
  "description": "Elza UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --watch --preserveWatchOutput --pretty",
    "start": "concurrently -n VITE,TS -c 'green,blue' 'npm run dev' 'npm run typecheck'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "locale:extract": "formatjs extract 'src/**/*.{ts,tsx,js,jsx}' --ignore 'src/**/*.{d,test}.{ts,tsx}' --out-file lang/translated/cs.json",
    "locale:merge": "node scripts/locale-merge.ts",
    "locale:compile": "formatjs compile-folder lang/translated public/static/res/locale",
    "locale:check": "node scripts/locale-check.ts",
    "locale:sync": "npm run locale:extract && npm run locale:merge -- --source cs cs en"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.51.1",
    "@stomp/stompjs": "^7.0.0",
    "@types/redux-form": "^8.3.10",
    "across-tabs": "^1.4.0",
    "axios": "^1.6.1",
    "bootstrap": "^5.3.2",
    "classnames": "^2.3.2",
    "diff": "^5.1.0",
    "dom-scroll-into-view": "^2.0.1",
    "elza-api": "file:target/elza-api",
    "es6-promise": "^4.2.8",
    "final-form": "^4.20.10",
    "final-form-arrays": "^3.1.0",
    "font-awesome": "^4.7.0",
    "jquery": "^3.7.1",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "ol": "^8.1.0",
    "path": "^0.12.7",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.0",
    "react-dom": "^18.2.0",
    "react-final-form": "^6.5.9",
    "react-final-form-arrays": "^3.1.4",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intl": "^6.8.7",
    "react-redux": "^8.1.2",
    "react-router": "^5.1.2",
    "react-router-bootstrap": "^0.25.0",
    "react-router-dom": "^5.1.2",
    "react-shortcuts": "^2.1.0",
    "react-textarea-autosize": "^8.5.3",
    "react-widgets": "^5.8.4",
    "react-widgets-moment": "^5.0.20",
    "redux": "^4.2.1",
    "redux-devtools-extension": "^2.13.9",
    "redux-form": "^8.3.10",
    "redux-immutable-state-invariant": "^2.1.0",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.4.2",
    "url-parse": "^1.5.10",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.3.11",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-redux": "^7.1.26",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^1.6.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^24.0.0",
    "msw": "^2.6.0",
    "sass": "^1.66.1",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^1.6.0"
  }
}
