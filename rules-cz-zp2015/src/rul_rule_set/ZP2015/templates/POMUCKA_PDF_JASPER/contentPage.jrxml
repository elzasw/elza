		</band>
		<band height="13">
			<printWhenExpression><![CDATA[// má typ arch. a není již obsažen v ukl. jedmotce
StringUtils.isNotBlank($V{unitType})&&
(
	$V{isFolder}||
	($V{isJednotlivost}&&
	  // preskoceni pokud je neevid. jednotlivost
	  ($F{node}.getItemsWithSpec("ZP2015_UNIT_TYPE","ZP2015_UNIT_TYPE_OTHER").size()==0)
	  // pokud obsahuje jednu UJ a jeden typ arch, porovname na shodu oznaceni
	  &&!(
	    ($F{node}.getItems(java.util.Collections.singletonList("ZP2015_STORAGE_ID")).size()==1)
   	    &&($F{node}.getItems(java.util.Collections.singletonList("ZP2015_UNIT_TYPE")).size()==1) 
	    // preskoceni pokud zacina ukl. jednotka typem
	    &&(
	    	$F{node}.getSingleItem("ZP2015_STORAGE_ID").getSerializedValue().startsWith( $F{node}.getSingleItem("ZP2015_UNIT_TYPE").getSpecification().getShortcut() ) ||
 	        $F{node}.getSingleItem("ZP2015_STORAGE_ID").getSerializedValue().startsWith( $F{node}.getSingleItem("ZP2015_UNIT_TYPE").getSpecification().getName() )
          )          
       )
  	) // konec jednotlivosti
	||($V{isCastJednotlivosti}
		// neni část jednotlivosti
	  &&($F{node}.getItemsWithSpec("ZP2015_UNIT_TYPE","ZP2015_UNIT_TYPE_PART").size()==0)
  		// kartotéční zásuvka
  	  &&($F{node}.getItemsWithSpec("ZP2015_UNIT_TYPE","ZP2015_UNIT_TYPE_KTT_BOX").size()==0)
   		// kartotéční lístek
  	  &&($F{node}.getItemsWithSpec("ZP2015_UNIT_TYPE","ZP2015_UNIT_TYPE_KTT_ITEM").size()==0)
	) // konec casti jednotlivosti
)]]></printWhenExpression>
			<element kind="textField" uuid="059a67c2-2b3d-4e0c-817f-f093ae803c13" key="" positionType="Float" mode="Transparent" x="0" y="0" width="455" height="13" backcolor="#99FF66" markup="html" pdfEncoding="Cp1250" textAdjust="StretchHeight" pattern="" removeLineWhenBlank="true" italic="false" style="Item">
				<expression><![CDATA[$V{isCastJednotlivosti}?
($F{node}.getItems(java.util.Collections.singletonList("ZP2015_UNIT_TYPE")).get(0).getSpecification().getName())
:($V{unitType}+($V{isEJ}?"; EJ":""))]]></expression>
			</element>
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
		</band>
		<band height="13">
			<printWhenExpression><![CDATA[$F{node}.getItems( java.util.Collections.singletonList("ZP2015_ITEM_LINK") ).size()>0]]></printWhenExpression>
			<element kind="component" uuid="05895990-3044-4faf-9507-304bd9fbb8c1" stretchType="ContainerHeight" x="50" y="0" width="404" height="13" removeLineWhenBlank="true" style="Item">
