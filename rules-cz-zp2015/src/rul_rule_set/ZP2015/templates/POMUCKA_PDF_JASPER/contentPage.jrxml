			<element kind="staticText" uuid="f3f3c75c-6dbf-4fc1-8ecc-612abc848dd4" x="0" y="0" width="40" height="13" removeLineWhenBlank="true" style="Item">
				<text><![CDATA[odkazy:]]></text>
			</element>
			<element kind="component" uuid="2884ae47-d2e6-4707-9ac0-3b3649763cda" stretchType="ContainerHeight" x="40" y="0" width="414" height="13" removeLineWhenBlank="true" style="Item">
