	</variable>
	<variable name="isEJ" class="java.lang.Boolean">
		<description><![CDATA[Zjištění, zda JP je evidenční jednotkou]]></description>
		<expression><![CDATA[// neni EJ, pokud je zneplatneny zaznam nebo propojeny zaznam
// je EJ pokud je slozkou a zaroven je hromadinovou slozkou, slozkou s typem EJ nebo obsahuje Extra EJ
// je EJ pokud je jednotlivosti a neni pod hromadinovou slozkou nebo slozkou s typem
($F{node}.getItems(java.util.Arrays.asList( "ZP2015_CONNECTED_RECORD", "ZP2015_ITEM_LINK", "ZP2015_INVALID_RECORD") ).size()==0)?(
  ($V{isFolder}&&(
  	 ($F{node}.getItemsWithSpec("ZP2015_FOLDER_TYPE","ZP2015_FOLDER_UNITS").size() > 0)||($F{node}.getItemsWithSpec("ZP2015_FOLDER_TYPE","ZP2015_FOLDER_SINGLE_TYPE").size() > 0)||($F{node}.getItems( java.util.Arrays.asList("ZP2015_EXTRA_UNITS") ).size() > 0)
  ))||(
  	$V{isJednotlivost}&&($F{node}.getItemsFromParent(java.util.Arrays.asList("ZP2015_FOLDER_TYPE"),java.util.Arrays.asList("ZP2015_FOLDER_UNITS","ZP2015_FOLDER_SINGLE_TYPE")).size()==0)&&($F{node}.getItemsWithSpec("ZP2015_UNIT_TYPE","ZP2015_UNIT_TYPE_OTHER").size()==0)
  )
):false]]></expression>
	</variable>
	<variable name="isContentNode" class="java.lang.Boolean">
		<description><![CDATA[Je uzel přímou součástí pomůcky?]]></description>
		<expression><![CDATA[$F{node}.getNodeId().isPublished()&&$F{node}.getParent()!=null&&$F{node}.getParent().isPublished()]]></expression>
	</variable>
	<variable name="rootRef" class="java.lang.String">
		<expression><![CDATA[$P{fund}.getInstitution().getCode()+"/"+$P{fund}.getFundNumber()]]></expression>
	</variable>
	<variable name="detail" class="java.lang.String">
		<expression><![CDATA[$V{isContentNode} ?
	$P{detailFormatter}.format($F{node}):
	$P{rootDetailFotmatter}.format($F{node})]]></expression>
	</variable>
	<variable name="unitDate" class="java.lang.String">
		<expression><![CDATA[$F{node}.getSingleItem( "ZP2015_UNIT_DATE_TEXT") == null ? $F{node}.getSingleItemValue( "ZP2015_UNIT_DATE" ) : $F{node}.getSingleItemValue( "ZP2015_UNIT_DATE_TEXT" )]]></expression>
	</variable>
	<variable name="levelName" class="java.lang.String">
		<expression><![CDATA[$F{node}.getItemsWithSpec("ZP2015_LEVEL_TYPE","ZP2015_LEVEL_ROOT").size() > 0 ? $P{fund}.getName() : $F{node}.getSingleItemValue("ZP2015_TITLE")]]></expression>
	</variable>
	<variable name="refNumber" class="java.lang.String">
		<expression><![CDATA[$V{isRoot} ? $V{rootRef} : 
	$F{node}.getSingleItemValue("ZP2015_UNIT_ID") + " " + $F{node}.getSingleItemValue("ZP2015_INV_CISLO")]]></expression>
	</variable>
	<variable name="storageId" class="java.lang.String">
		<expression><![CDATA[$P{storageFormatter}.format($F{node})]]></expression>
	</variable>
	<variable name="otherIds" class="java.lang.String">
		<expression><![CDATA[$P{otherIdFormatter}.format($F{node})]]></expression>
	</variable>
	<variable name="serialNumber" class="java.lang.String">
		<expression><![CDATA[$F{node}.getSingleItemValue("ZP2015_SERIAL_NUMBER")]]></expression>
	</variable>
	<variable name="shortDetail" class="java.lang.String">
		<expression><![CDATA[$V{isContentNode} ?
$P{shortDetailFormatter}.format($F{node}):
$P{rootShortDetailFormatter}.format($F{node})]]></expression>
	</variable>
	<variable name="contentEntry" class="java.lang.String">
		<expression><![CDATA[($F{depth}==1)?"Jednotky popisu":(($V{levelName}.length()>50)?$V{levelName}.substring(0,50)+"...":$V{levelName})+" "+$V{unitDate}]]></expression>
	</variable>
	<variable name="unitType" class="java.lang.String">
		<description><![CDATA[Typ archiválie + identifikace EJ]]></description>
		<expression><![CDATA[$P{unitTypeFormatter}.format($F{node})]]></expression>
	</variable>
